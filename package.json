{
    "name": "loadsheeding-backend",
    "version": "1.0.0",
    "description": "Loadshedding System Backend",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsup",
        "start": "node dist/server.js",
        "postinstall": "prisma generate",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "seed": "tsx src/app/scripts/seedAdmin.ts",
        "format:check": "npx @biomejs/biome format ./src",
        "format:fix": "npx @biomejs/biome format --write ./src",
        "lint:check": "npx @biomejs/biome lint ./src",
        "lint:fix": "npx @biomejs/biome lint --write ./src"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.5",
        "helmet": "^8.3.0",
        "http-status": "^2.1.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.0",
        "prisma": "^7.9.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
