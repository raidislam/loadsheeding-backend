NODE_ENV=development
PORT=5000

# Neon PostgreSQL connection string (pooled). Paste from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
# Direct (unpooled) Neon connection - used only by Prisma CLI for migrations (host without -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=generate_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=generate_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Requests per IP per 15 minutes (all /api/v1 routes) and failed login/register attempts
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# SSLCommerz (sandbox: https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
# false = sandbox (test money), true = live (real money)
SSLCOMMERZ_IS_LIVE=false
# Leave empty to use BACKEND_URL/api/v1/payments/{success|fail|cancel|ipn}
SSLCOMMERZ_SUCCESS_URL=
SSLCOMMERZ_FAIL_URL=
SSLCOMMERZ_CANCEL_URL=
SSLCOMMERZ_IPN_URL=
